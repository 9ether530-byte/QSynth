{
  "name": "qsynth",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:api": "node scripts/build-api.mjs",
    "build:migrate": "node scripts/build-migrate.mjs",
    "build": "npm run build:api && npm run build:migrate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.1",
    "pg": "^8.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
