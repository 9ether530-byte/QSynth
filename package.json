{
  "name": "qsynth",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:api": "node scripts/build-api.mjs",
    "build:migrate": "node scripts/build-migrate.mjs",
    "build": "npm run build:api && npm run build:migrate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:app": "npm --prefix app run test",
    "build:app": "npm --prefix app run build",
    "docs:errors": "UPDATE_DOCS=1 vitest run functions/api/test/errorcatalog.test.ts",
    "docs:endpoints": "UPDATE_DOCS=1 vitest run functions/api/test/endpoints.test.ts",
    "docs:manifest": "UPDATE_DOCS=1 vitest run packages/qsynth-core/test/manifest.test.ts",
    "docs": "npm run docs:errors && npm run docs:endpoints && npm run docs:manifest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1135.0",
    "@types/node": "^24.13.5",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.1",
    "pg": "^8.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
